<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinUI 3 桌面应用。只能在 Windows 上用 Visual Studio 2022+ 或 `dotnet build -r win-x64` 构建。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\DrawOffer.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DrawOffer.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- 先用非打包（unpackaged）模式跑通；MSIX 打包与签名属于发布阶段 -->
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 界面全部用 C# 构建，没有 .xaml 文件；入口 Main 写在 App.cs -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DrawOffer.Core\DrawOffer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 离线纸面渲染页，由 apps/native/scripts/build_renderer.mjs 生成 -->
    <Content Include="Assets\DrawOffer.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Home\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Models\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Library\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Career\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Branding\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Renderer\paper.html" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Renderer\paper.html') Or $([MSBuild]::IsOSPlatform('Windows'))" />
    <!-- 可编辑纸面（ResumeEditorPaperView）与它引用的模板示例头像，同样由 build_renderer.mjs 生成 -->
    <Content Include="Assets\Renderer\editor.html" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Renderer\editor.html') Or $([MSBuild]::IsOSPlatform('Windows'))" />
    <Content Include="Assets\Renderer\templates\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    非 Windows 主机（macOS CI 与本地对照）上只做 C# 编译检查：XAML 编译器与 makepri 是 Windows 程序无法运行，
    而本工程没有 .xaml 文件，跳过两遍标记编译和资源索引不影响 C# 结果。产物不可运行，只用于发现类型与 API 错误。
    用法：bash scripts/typecheck.sh
  -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <Target Name="MarkupCompilePass1" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  <Target Name="MarkupCompilePass2" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
</Project>
